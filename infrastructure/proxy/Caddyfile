# ══════════════════════════════════════════════════════════════
# HumsYarX — Production Caddyfile for sw2.pwker.ir
# Wave 7: TLS 1.3, HTTP/2 & HTTP/3, HSTS, Compression & Caching
# ══════════════════════════════════════════════════════════════

{$DOMAIN:sw2.pwker.ir} {
    # ── 1. TLS 1.3 Enforcement & Automated Let's Encrypt ──
    tls {
        protocols tls1.2 tls1.3
        curves x25519 secp256r1
    }

    # ── 2. Performance & Compression ──
    encode zstd gzip

    # ── 3. Request Size Boundaries (Max 50MB) ──
    request_body {
        max_size 50MB
    }

    # ── 4. Security Headers ──
    header {
        # HTTP Strict Transport Security (HSTS)
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # MIME type sniffing prevention
        X-Content-Type-Options "nosniff"
        # Frame protection: Allow self and Telegram WebApp parent
        Content-Security-Policy "frame-ancestors 'self' https://web.telegram.org https://*.telegram.org;"
        X-Frame-Options "SAMEORIGIN"
        # Referrer Policy
        Referrer-Policy "strict-origin-when-cross-origin"
        # Hardware Feature Permissions
        Permissions-Policy "accelerometer=(), camera=(), microphone=(), geolocation=(), payment=()"
        # Cross-Origin Policies
        Cross-Origin-Opener-Policy "same-origin-allow-popups"
        # Strip Server Identification
        -Server
    }

    # ── 5. Static Assets Immutable Caching (Hashed Chunks) ──
    @static {
        path /student/assets/* /app/assets/* /admin/assets/*
    }
    header @static {
        Cache-Control "public, max-age=31536000, immutable"
    }

    # ── 6. Protected DRM Reader Endpoints (Zero Cache Proxy Enforcement) ──
    @drm_protected {
        path /api/web/reader/page/* /api/web/reader/manifest/*
    }
    header @drm_protected {
        Cache-Control "private, no-store, no-cache, max-age=0, must-revalidate"
        Pragma "no-cache"
    }

    # ── 7. Reverse Proxy Upstream to FastAPI ──
    reverse_proxy app:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        # Buffering tuning for streaming & SSE
        flush_interval -1
        transport http {
            keepalive 30s
            keepalive_idle_conns 100
        }
    }
}
